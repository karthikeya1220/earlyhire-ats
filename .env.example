# EarlyHire ATS — environment variables

# Copy to `.env.local` and fill in real values. Never prefix secrets with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY is server-only: it bypasses RLS and must never reach client code.

# Server-only (Next.js server actions / route handlers only).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Client-safe (exposed to the browser by design — publishable key, RLS-scoped).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
